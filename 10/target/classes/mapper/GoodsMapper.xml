<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.GoodsMapper">
    
    <insert id="addGoods" parameterType="com.example.demo.entity.GoodsInfo">
        INSERT INTO tb_goods (name, price, type) 
        VALUES (#{name}, #{price}, #{type})
    </insert>

    <select id="findAllGoods" resultType="com.example.demo.entity.GoodsInfo">
        SELECT * FROM tb_goods
    </select>
</mapper>